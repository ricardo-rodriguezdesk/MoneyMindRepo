# Copia este archivo como .env y ajusta los valores
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=moneymind
# En la nube (base de datos remota) pon DB_SSL=true
DB_SSL=false
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=30d
APP_URL=http://localhost:5173
# Correo (HU03). Si SMTP_HOST está vacío, el correo se imprime en la consola del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MoneyMind <no-reply@moneymind.app>"
# IA (HU05A). La llave NO se versiona; cada integrante crea la suya en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=5000
# Opcional: 0 apaga el razonamiento del modelo y responde más rápido. Déjalo vacío si el modelo no lo acepta.
GEMINI_THINKING_BUDGET=
